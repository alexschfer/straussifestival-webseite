# Kopieren nach deploy/deploy.env (wird nicht committet) und ausfüllen:
#   cp deploy/deploy.env.example deploy/deploy.env
# Gilt für jeden Anbieter gleich (Selfnet, Hetzner, ...): nur der Host ändert sich.

# Adresse der VM (IP-Adresse oder Hostname; ein Alias aus ~/.ssh/config geht auch).
DEPLOY_HOST=vm.example.org

# Benutzer für SSH. Root-Zugriff ist vorausgesetzt; ein anderer Benutzer geht,
# wenn er Docker ohne sudo benutzen darf (Gruppe "docker") und in DEPLOY_PATH schreiben darf.
DEPLOY_USER=root

# Ordner auf der VM, in dem alles liegt (docker-compose.yml, .env, site/, backups/).
DEPLOY_PATH=/opt/straussi

# SSH-Port der VM.
DEPLOY_SSH_PORT=22

# E-Mail-Adresse für Hinweise von Let's Encrypt. Wird nur beim ERSTEN Deploy gebraucht,
# wenn das Skript die .env auf der VM anlegt.
ACME_EMAIL=admin@example.org
