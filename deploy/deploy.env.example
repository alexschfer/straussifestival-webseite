# Copy to deploy/deploy.env (not committed) and fill in:
#   cp deploy/deploy.env.example deploy/deploy.env
# Works the same for every provider (Selfnet, Hetzner, ...): only the host changes.

# Address of the VM (IP address or hostname; an alias from ~/.ssh/config also works).
DEPLOY_HOST=vm.example.org

# SSH user. Root access is assumed; another user works
# if it may use Docker without sudo (group "docker") and write to DEPLOY_PATH.
DEPLOY_USER=root

# Folder on the VM that holds everything (docker-compose.yml, .env, site/, backups/).
DEPLOY_PATH=/opt/straussi

# SSH port of the VM.
DEPLOY_SSH_PORT=22

# Email address for notices from Let's Encrypt. Only needed on the FIRST deploy,
# when the script creates the .env on the VM.
ACME_EMAIL=admin@example.org
