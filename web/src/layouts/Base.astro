---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import CookieBanner from '../components/CookieBanner.astro';
import InstaIcon from '../components/InstaIcon.astro';
import TikTokIcon from '../components/TikTokIcon.astro';
import TicketButton from '../components/TicketButton.astro';
import UtmWeitergabe from '../components/UtmWeitergabe.astro';
import { bannerAktiv, festival, instagram, tiktok, ticket } from '../config';

interface Props {
  title: string;
  description: string;
  /** Die Startseite bekommt den Festivalnamen als Titel, alle anderen "Seite – Festival". */
  startseite?: boolean;
}

const { title, description, startseite = false } = Astro.props;

// Navigation: neue Seite = neue Datei in src/pages/ und hier eine Zeile ergänzen.
// bald: true = Seite ist noch nicht fertig. Der Punkt steht ausgegraut mit „bald“
// im Menü, ist aber kein Link. Sobald die Seite fertig ist, "bald: true" löschen.
const hauptmenue: { href: string; text: string; bald?: boolean }[] = [
  { href: '/', text: 'Start' },
  { href: '/infos/', text: 'Infos' },
  { href: '/lineup/', text: 'Line-up', bald: true },
  { href: '/faq/', text: 'FAQ' },
  { href: '/anfahrt/', text: 'Anfahrt', bald: true },
  { href: '/bewohner/', text: 'Bewohner*innen', bald: true },
];
// Rechtliches: erscheint unten in der schmalen Leiste der Fußzeile.
const fussmenue = [
  { href: '/impressum/', text: 'Impressum' },
  { href: '/datenschutz/', text: 'Datenschutz' },
];
// Das Menü oben erscheint in der Fußzeile noch einmal als Spalte "Festival".

const seitentitel = startseite ? festival.name : `${title} – ${festival.kurzname}`;
const aktuellerPfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const istAktuell = (href: string) => (href.replace(/\/$/, '') || '/') === aktuellerPfad;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1c20" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/logo-klein.png" type="image/png" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <img src="/logo-klein.png" alt="" width="28" height="28" />
          <span>{festival.kurzname} <span class="akzent">{festival.jahr}</span></span>
        </a>
        <TicketButton position="header" text="Tickets" class="button-klein" />
        <nav aria-label="Hauptmenü">
          <ul>
            {
              hauptmenue.map((eintrag) => (
                <li>
                  {eintrag.bald ? (
                    <span class="menue-bald">
                      {eintrag.text} <small>bald</small>
                    </span>
                  ) : (
                    <a href={eintrag.href} aria-current={istAktuell(eintrag.href) ? 'page' : undefined}>
                      {eintrag.text}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-panel">
        <div class="footer-spalten">
          <div class="footer-spalte">
            <h2>Folge uns</h2>
            <p class="footer-spalte-text">Neuigkeiten gibt es zuerst auf Instagram und TikTok.</p>
            <div class="footer-icons">
              <a
                class="footer-icon"
                href={instagram.profilUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${instagram.name} auf Instagram`}
              >
                <InstaIcon size={20} />
              </a>
              <a
                class="footer-icon"
                href={tiktok.profilUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${tiktok.name} auf TikTok`}
              >
                <TikTokIcon size={20} />
              </a>
            </div>
          </div>

          <nav class="footer-spalte" aria-label="Festival">
            <h2>Festival</h2>
            <ul>
              {
                hauptmenue.map((eintrag) => (
                  <li>
                    {eintrag.bald ? (
                      <span class="menue-bald">
                        {eintrag.text} <small>bald</small>
                      </span>
                    ) : (
                      <a href={eintrag.href}>{eintrag.text}</a>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="footer-spalte">
            <h2>Tickets</h2>
            <p class="footer-spalte-text">Der Verkauf läuft über unseren Ticketpartner.</p>
            <TicketButton position="footer" class="button-klein" />
          </div>

          <div class="footer-spalte">
            <h2>Kontakt</h2>
            <p class="footer-spalte-text"><a href={`mailto:${festival.email}`}>{festival.email}</a></p>
          </div>
        </div>

        <div class="footer-unten">
          <div class="footer-marke">
            <img src="/logo-klein.png" alt="" width="40" height="40" class="footer-logo" />
            <div>
              <p class="footer-name">{festival.kurzname} <span class="akzent">{festival.jahr}</span></p>
              <p class="footer-veranstalter">{festival.veranstalter}</p>
            </div>
          </div>
          <div class="footer-recht">
            <nav aria-label="Rechtliches">
              <ul>
                {
                  fussmenue.map((eintrag) => (
                    <li>
                      <a href={eintrag.href}>{eintrag.text}</a>
                    </li>
                  ))
                }
                {
                  bannerAktiv && (
                    <li>
                      <a href="/datenschutz/#cookies" data-cookie-einstellungen>
                        Cookie-Einstellungen
                      </a>
                    </li>
                  )
                }
              </ul>
            </nav>
            <p class="footer-copyright">© {festival.name}</p>
          </div>
        </div>
      </div>
    </footer>

    {ticket.utmWeitergeben && <UtmWeitergabe />}
    {bannerAktiv && <CookieBanner />}
  </body>
</html>
