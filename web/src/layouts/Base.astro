---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import CookieBanner from '../components/CookieBanner.astro';
import InstaIcon from '../components/InstaIcon.astro';
import TikTokIcon from '../components/TikTokIcon.astro';
import TicketButton from '../components/TicketButton.astro';
import UtmForwarding from '../components/UtmForwarding.astro';
import { bannerActive, festival, instagram, tiktok, ticket } from '../config';
import { TEXTS, localPath, pathInLanguage, languageOf } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** The home page gets the festival name as its title, all others "Page – Festival". */
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;

// Language from the URL (/en/... = English), texts of the shared components from src/i18n.ts.
const language = languageOf(Astro.url);
const t = TEXTS[language];
const otherLanguage = language === 'de' ? 'en' : 'de';

// Navigation: new page = new file in src/pages/ (and in src/pages/en/) plus one line
// here; the menu text lives in src/i18n.ts under "menu".
// soon: true = page isn't finished yet. The item appears grayed out with "soon" ("bald")
// in the menu but is not a link. Once the page is finished, delete "soon: true".
const mainMenu: { href: string; text: string; soon?: boolean }[] = [
  { href: '/', text: t.menu.home },
  { href: '/infos/', text: t.menu.info },
  { href: '/lineup/', text: t.menu.lineup, soon: true },
  { href: '/faq/', text: t.menu.faq },
  { href: '/anfahrt/', text: t.menu.directions },
  { href: '/bewohner/', text: t.menu.residents, soon: true },
].map((item) => ({ ...item, href: localPath(item.href, language) }));
// Legal: appears at the bottom in the narrow bar of the footer.
const footerMenu = [
  { href: '/impressum/', text: t.menu.imprint },
  { href: '/datenschutz/', text: t.menu.privacy },
].map((item) => ({ ...item, href: localPath(item.href, language) }));

// The same page in the other language (for the language switch and hreflang).
const otherLanguagePath = pathInLanguage(Astro.url.pathname, otherLanguage);
// The 404 page exists only once (bilingual), so no switch there.
const showLanguageSwitch = !Astro.url.pathname.startsWith('/404');
// The top menu appears again in the footer as the "Festival" column.

const pageTitle = isHome ? festival.name : `${title} – ${festival.shortName}`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/$/, '') || '/') === currentPath;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1c20" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      showLanguageSwitch && (
        <>
          <link rel="alternate" hreflang={language} href={new URL(Astro.url.pathname, Astro.site)} />
          <link rel="alternate" hreflang={otherLanguage} href={new URL(otherLanguagePath, Astro.site)} />
        </>
      )
    }
    <link rel="icon" href="/logo-klein.png" type="image/png" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#content">{t.skipToContent}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={localPath('/', language)}>
          <img src="/logo-klein.png" alt="" width="28" height="28" />
          <span>{festival.shortName} <span class="accent">{festival.year}</span></span>
        </a>
        <TicketButton position="header" text={t.tickets} class="button-small" />
        <nav aria-label={t.mainMenu}>
          <ul>
            {
              mainMenu.map((item) => (
                <li>
                  {item.soon ? (
                    <span class="menu-soon">
                      {item.text} <small>{t.soon}</small>
                    </span>
                  ) : (
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.text}
                    </a>
                  )}
                </li>
              ))
            }
            {
              showLanguageSwitch && (
                <li>
                  <a class="language-switch" href={otherLanguagePath} hreflang={t.otherLanguage.lang} lang={t.otherLanguage.lang} aria-label={t.otherLanguage.name}>
                    {t.otherLanguage.short}
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-panel">
        <div class="footer-columns">
          <div class="footer-column">
            <h2>{t.followUs}</h2>
            <p class="footer-column-text">{t.followUsText}</p>
            <div class="footer-icons">
              <a
                class="footer-icon"
                href={instagram.profileUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${instagram.name} ${t.onInstagram}`}
              >
                <InstaIcon size={20} />
              </a>
              <a
                class="footer-icon"
                href={tiktok.profileUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${tiktok.name} ${t.onTikTok}`}
              >
                <TikTokIcon size={20} />
              </a>
            </div>
          </div>

          <nav class="footer-column" aria-label="Festival">
            <h2>Festival</h2>
            <ul>
              {
                mainMenu.map((item) => (
                  <li>
                    {item.soon ? (
                      <span class="menu-soon">
                        {item.text} <small>{t.soon}</small>
                      </span>
                    ) : (
                      <a href={item.href}>{item.text}</a>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="footer-column">
            <h2>{t.tickets}</h2>
            <p class="footer-column-text">{t.salesText[0]}<a href={ticket.partnerUrl} target="_blank" rel="noopener">{t.salesText[1]}</a>{t.salesText[2]}</p>
            <TicketButton position="footer" class="button-small" />
          </div>

          <div class="footer-column">
            <h2>{t.contact}</h2>
            <ul class="footer-contact">
              <li><a href={`mailto:${festival.email}`}>{festival.email}</a></li>
              <li>
                <span>Acts</span>
                <a href={`mailto:${festival.emailActs}`}>{festival.emailActs}</a>
              </li>
              <li>
                <span>Sponsoring</span>
                <a href={`mailto:${festival.emailSponsoring}`}>{festival.emailSponsoring}</a>
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div class="footer-brand">
            <img src="/logo-klein.png" alt="" width="40" height="40" class="footer-logo" />
            <div>
              <p class="footer-name">{festival.shortName} <span class="accent">{festival.year}</span></p>
              <p class="footer-organizer">{t.organizer}</p>
            </div>
          </div>
          <div class="footer-legal">
            <nav aria-label={t.legal}>
              <ul>
                {
                  footerMenu.map((item) => (
                    <li>
                      <a href={item.href}>{item.text}</a>
                    </li>
                  ))
                }
                {
                  bannerActive && (
                    <li>
                      <a href={`${localPath('/datenschutz/', language)}#cookies`} data-cookie-settings>
                        {t.cookieSettings}
                      </a>
                    </li>
                  )
                }
              </ul>
            </nav>
            <p class="footer-copyright">© {festival.name}</p>
          </div>
        </div>
      </div>
    </footer>

    {ticket.forwardUtm && <UtmForwarding />}
    {bannerActive && <CookieBanner />}
  </body>
</html>
