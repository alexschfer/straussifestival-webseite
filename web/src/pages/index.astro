---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import InstaAbschnitt from '../components/InstaAbschnitt.astro';
import TicketButton from '../components/TicketButton.astro';
import { festival, startBilder } from '../config';
---

<Base title="Startseite" description="Das Straußi Festival 2027 der Studierendenwohnheime Straußäcker in Stuttgart. Infos zu Programm, Anfahrt und Tickets." startseite>
  <section class="hero">
    <div class="hero-fotos">
      {
        startBilder.map((foto, i) => (
          <div class="hero-foto" data-parallax={[0.1, 0.18, 0.26][i % 3]}>
            <img src={foto.bild} alt={foto.alt} loading="eager" />
          </div>
        ))
      }
    </div>
    <div class="hero-verlauf"></div>
    <div class="wrap-breit">
      <img class="hero-logo" src="/logo.webp" alt="" width="88" height="88" />
      <h1>{festival.kurzname} <span class="akzent">{festival.jahr}</span></h1>
      <p class="hero-facts">{festival.datum} · {festival.ort}</p>
      <TicketButton position="hero" class="button-gross" />
    </div>
  </section>

  <section class="abschnitt-countdown einblenden" aria-labelledby="countdown-titel">
    <div class="countdown-panel">
      <h2 id="countdown-titel">Countdown bis zum {festival.kurzname}</h2>
      <Countdown />
    </div>
  </section>

  <div class="wrap prose einblenden">
    <p>
      Das <strong>Straußi Festival 2027</strong> ist das Festival der Studierendenwohnheime Straußäcker in Stuttgart, veranstaltet von einem Team aus Bewohner*innen des Straußi 1, 2 & 3.
    </p>
    <p>Zwei Tage, ein Gelände, jede Menge gute Laune: Am 11. und 12. Juni 2027 wird das Gelände der Straußäcker-Wohnheime zur Festivalfläche. Von Studis organisiert, für alle ab 18, mit Musik, Foodtrucks und Getränken bis 1 Uhr nachts.</p>
    <h2>Programm und Line-up</h2>
    <p>Das Line-up steht noch nicht fest. Wir geben es hier bekannt, sobald es so weit ist.</p>
    {/* Sobald lineup.astro fertig ist: wieder auf die Line-up-Seite verlinken. */}
    <h2>Tickets</h2>
    <p>Tickets gibt es über unseren Ticketpartner. Der Button oben führt direkt zum Ticketshop.</p>
    <p>Es wird Wochenend-, Early-Bird- und Tagestickets geben. Der Start des Vorverkaufs und die Preise werden noch bekanntgegeben.</p>
    {/* TODO: Datum des Vorverkaufsstarts und Preise eintragen, sobald sie feststehen. */}
    <h2>Gut zu wissen</h2>
    <ul>
      <li>Alle Infos zum Ablauf: <a href="/infos/">Infos</a></li>
      <li>Häufige Fragen: <a href="/faq/">FAQ</a></li>
      {/* Sobald anfahrt.astro fertig ist, wieder einfügen: <li>So kommst du hin: <a href="/anfahrt/">Anfahrt</a></li> */}
    </ul>
  </div>

  <div class="einblenden">
    <InstaAbschnitt />
  </div>
</Base>

<script>
  // Blendet Abschnitte mit der Klasse "einblenden" sanft ein, sobald sie beim Scrollen
  // in den sichtbaren Bereich kommen. Wichtig: Ausgeblendet wird erst, wenn dieses Skript
  // läuft (Klasse "einblenden-aktiv" am <html>). Läuft es nicht (Browser, Blocker, Skript
  // lädt nicht), bleiben alle Inhalte einfach sichtbar. Der ausgeblendete Zustand steht im
  // CSS außerdem nur ohne reduzierte Bewegung.
  const abschnitte = Array.from(document.querySelectorAll<HTMLElement>('.einblenden'));

  if (abschnitte.length && 'IntersectionObserver' in window) {
    // Was schon im Bild ist, sofort als sichtbar markieren, damit nichts kurz verschwindet.
    for (const abschnitt of abschnitte) {
      const rect = abschnitt.getBoundingClientRect();
      if (rect.top < innerHeight && rect.bottom > 0) abschnitt.classList.add('sichtbar');
    }
    document.documentElement.classList.add('einblenden-aktiv');

    const beobachter = new IntersectionObserver(
      (eintraege, beobachterInstanz) => {
        for (const eintrag of eintraege) {
          if (eintrag.isIntersecting) {
            eintrag.target.classList.add('sichtbar');
            beobachterInstanz.unobserve(eintrag.target);
          }
        }
      },
      // Schon bei der ersten sichtbaren Zeile auslösen (auch bei sehr hohen Abschnitten
      // auf kleinen Bildschirmen), etwas vor der Unterkante.
      { threshold: 0, rootMargin: '0px 0px -10% 0px' },
    );
    abschnitte.filter((a) => !a.classList.contains('sichtbar')).forEach((a) => beobachter.observe(a));
  }
</script>

<script>
  // Leichter Parallax-Effekt für die drei Startbild-Fotos: bewusst per JS mit einem gedrosselten
  // scroll-Listener statt background-attachment: fixed oder CSS-Scroll-Timelines, weil Fixed-
  // Backgrounds auf iOS Safari unzuverlässig sind und Scroll-Timelines dort noch nicht unterstützt
  // werden – die meisten Gäste kommen laut CLAUDE.md mobil per QR-Code. Bei reduzierter Bewegung
  // bleiben die Fotos stehen.
  const hero = document.querySelector<HTMLElement>('.hero');
  const fotos = document.querySelectorAll<HTMLElement>('.hero-foto');

  if (hero && fotos.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    let angefragt = false;

    const aktualisieren = () => {
      angefragt = false;
      const rect = hero.getBoundingClientRect();
      // Nur rechnen, solange der Startbildschirm überhaupt (teilweise) sichtbar ist.
      if (rect.bottom < 0 || rect.top > innerHeight) return;
      fotos.forEach((foto) => {
        const faktor = Number(foto.dataset.parallax ?? 0);
        foto.style.transform = `translateY(${rect.top * faktor * -1}px)`;
      });
    };

    const anfragen = () => {
      if (!angefragt) {
        angefragt = true;
        requestAnimationFrame(aktualisieren);
      }
    };

    aktualisieren();
    addEventListener('scroll', anfragen, { passive: true });
  }
</script>
