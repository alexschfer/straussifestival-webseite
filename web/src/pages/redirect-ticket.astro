---
/**
 * Redirect straight to the ticket shop, counted in Matomo.
 *
 * Meant for links on other websites that should lead directly to buying, e.g.
 * /redirect-ticket/q/rausgegangen or /redirect-ticket/q/studentenpartys-stuttgart.
 * Like every page, it works with all channels: /redirect-ticket/q/<slug> first
 * redirects to /redirect-ticket/?utm_source=...&..., this page counts the visit
 * including the channel in Matomo and then sends the visitor on to the shop. The UTM
 * parameters are passed on to the shop (taken from this page's address, nothing is
 * stored) so the shop can see the channel too (docs/TICKETSHOP-UTM.md).
 *
 * Analysis in Matomo: event category "Ticket", action "Weiterleitung", broken down
 * by campaign/source. This also counts towards a goal on the category "Ticket".
 *
 * Deliberately without the shared layout (no header/footer, no cookie banner):
 * the page is only visible for a moment. Same structure as redirect-instagram.astro.
 */
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { analytics, analyticsActive, festival, ticket } from '../config';

const target = ticket.url;
const tracking = {
  active: analyticsActive,
  category: analytics.ticketCategory,
  action: analytics.ticketRedirectAction,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1c20" />
    <meta name="robots" content="noindex" />
    <title>Weiter zum Ticketshop – {festival.shortName}</title>
    <link rel="icon" href="/logo-klein.png" type="image/png" />
    <!-- Without JavaScript the redirect still happens after 3 seconds (then without counting and without the channel). -->
    <meta http-equiv="refresh" content={`3;url=${target}`} />
    <Analytics autoTrack={false} />
  </head>
  <body>
    <main class="wrap prose continue">
      <img src="/logo-klein.png" alt="" width="96" height="96" />
      <p>Weiter zum <strong>Ticketshop</strong> …</p>
      <p>Falls nichts passiert:</p>
      <a class="button button-large" href={target} data-continue-link>Zu den Tickets</a>
    </main>

    <script is:inline define:vars={{ target, tracking }}>
      // Append the channel (UTM parameters) of this address to the shop link.
      var targetWithChannel = new URL(target);
      new URLSearchParams(location.search).forEach(function (value, name) {
        if (name.indexOf('utm_') === 0 && !targetWithChannel.searchParams.has(name)) {
          targetWithChannel.searchParams.set(name, value);
        }
      });
      var button = document.querySelector('[data-continue-link]');
      if (button) button.href = targetWithChannel.href;

      // Count first (page view and event), then redirect. Redirects after 1.5 seconds
      // at the latest, even if Matomo does not respond or is blocked.
      // Without Matomo immediately.
      var redirected = false;
      var redirect = function () {
        if (redirected) return;
        redirected = true;
        location.replace(targetWithChannel.href);
      };
      if (!tracking.active) {
        redirect();
      } else {
        var _paq = (window._paq = window._paq || []);
        _paq.push(['trackPageView']);
        // Last value: Matomo calls "redirect" as soon as the event has been sent.
        _paq.push(['trackEvent', tracking.category, tracking.action, undefined, undefined, undefined, redirect]);
        setTimeout(redirect, 1500);
      }
    </script>
  </body>
</html>

<style>
  .continue {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
</style>
