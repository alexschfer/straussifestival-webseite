---
/**
 * Redirect to the Instagram profile, counted in Matomo.
 *
 * Meant for QR codes that should lead straight to Instagram. Like every page,
 * it works with all channels: /redirect-instagram/q/flyer first redirects to
 * /redirect-instagram/?utm_source=flyer&..., this page counts the visit including
 * the channel in Matomo and then sends the visitor on to Instagram. The finished
 * QR codes are in docs/qr/redirect-instagram/.
 *
 * Analysis in Matomo: event category "Instagram", action "Weiterleitung"
 * (clearly separated from website visits), broken down by campaign/source.
 *
 * Deliberately without the shared layout (no header/footer, no cookie banner):
 * the page is only visible for a moment.
 */
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { analytics, analyticsActive, festival, instagram } from '../config';

const target = instagram.profileUrl;
const tracking = {
  active: analyticsActive,
  category: analytics.instaCategory,
  action: analytics.instaAction,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1c20" />
    <meta name="robots" content="noindex" />
    <title>Weiter zu Instagram – {festival.shortName}</title>
    <link rel="icon" href="/logo-klein.png" type="image/png" />
    <!-- Without JavaScript the redirect still happens after 3 seconds (then without counting). -->
    <meta http-equiv="refresh" content={`3;url=${target}`} />
    <Analytics autoTrack={false} />
  </head>
  <body>
    <main class="wrap prose continue">
      <img src="/logo-klein.png" alt="" width="96" height="96" />
      <p>Weiter zu <strong>{instagram.name}</strong> auf Instagram …</p>
      <p>Falls nichts passiert:</p>
      <a class="button button-large" href={target}>Zu Instagram</a>
    </main>

    <script is:inline define:vars={{ target, tracking }}>
      // Count first (page view and own event), then redirect.
      // Redirects after 1.5 seconds at the latest, even if Matomo does not
      // respond or is blocked. Without Matomo immediately.
      var redirected = false;
      var redirect = function () {
        if (redirected) return;
        redirected = true;
        location.replace(target);
      };
      if (!tracking.active) {
        redirect();
      } else {
        var _paq = (window._paq = window._paq || []);
        _paq.push(['trackPageView']);
        // Last value: Matomo calls "redirect" as soon as the event has been sent.
        _paq.push(['trackEvent', tracking.category, tracking.action, undefined, undefined, undefined, redirect]);
        setTimeout(redirect, 1500);
      }
    </script>
  </body>
</html>

<style>
  .continue {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
</style>
