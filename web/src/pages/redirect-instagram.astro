---
/**
 * Weiterleitung zum Instagram-Profil, mit Zählung in Matomo.
 *
 * Gedacht für QR-Codes, die direkt auf Instagram führen sollen. Wie jede Seite
 * funktioniert sie mit allen Kanälen: /redirect-instagram/q/flyer leitet erst auf
 * /redirect-instagram/?utm_source=flyer&... weiter, diese Seite zählt den Aufruf samt
 * Kanal in Matomo und schickt den Besucher dann zu Instagram. Die fertigen
 * QR-Codes liegen in docs/qr/redirect-instagram/.
 *
 * Auswertung in Matomo: Ereignis Kategorie "Instagram", Aktion "Weiterleitung"
 * (klar getrennt von den Webseiten-Besuchen), nach Kampagne/Quelle aufschlüsseln.
 *
 * Bewusst ohne das gemeinsame Layout (keine Kopf-/Fußzeile, kein Cookie-Banner):
 * Die Seite ist nur einen Augenblick zu sehen.
 */
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { analytics, analyticsAktiv, festival, instagram } from '../config';

const ziel = instagram.profilUrl;
const zaehlen = {
  aktiv: analyticsAktiv,
  kategorie: analytics.instaKategorie,
  aktion: analytics.instaAktion,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1c20" />
    <meta name="robots" content="noindex" />
    <title>Weiter zu Instagram – {festival.kurzname}</title>
    <link rel="icon" href="/logo-klein.png" type="image/png" />
    <!-- Ohne JavaScript geht es nach 3 Sekunden trotzdem weiter (dann ohne Zählung). -->
    <meta http-equiv="refresh" content={`3;url=${ziel}`} />
    <Analytics autoTrack={false} />
  </head>
  <body>
    <main class="wrap prose weiter">
      <img src="/logo-klein.png" alt="" width="96" height="96" />
      <p>Weiter zu <strong>{instagram.name}</strong> auf Instagram …</p>
      <p>Falls nichts passiert:</p>
      <a class="button button-gross" href={ziel}>Zu Instagram</a>
    </main>

    <script is:inline define:vars={{ ziel, zaehlen }}>
      // Erst zählen (Seitenaufruf und eigenes Ereignis), dann weiterleiten.
      // Spätestens nach 1,5 Sekunden geht es weiter, auch wenn Matomo nicht
      // antwortet oder blockiert ist. Ohne Matomo sofort.
      var weitergeleitet = false;
      var weiter = function () {
        if (weitergeleitet) return;
        weitergeleitet = true;
        location.replace(ziel);
      };
      if (!zaehlen.aktiv) {
        weiter();
      } else {
        var _paq = (window._paq = window._paq || []);
        _paq.push(['trackPageView']);
        // Letzter Wert: Matomo ruft "weiter" auf, sobald das Ereignis verschickt ist.
        _paq.push(['trackEvent', zaehlen.kategorie, zaehlen.aktion, undefined, undefined, undefined, weiter]);
        setTimeout(weiter, 1500);
      }
    </script>
  </body>
</html>

<style>
  .weiter {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
</style>
