---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  // Die Startseite (start.md) hat ihre eigene Route in index.astro.
  return seiten
    .filter((seite) => seite.id !== 'start')
    .map((seite) => ({ params: { slug: seite.id }, props: { seite } }));
}

const { seite } = Astro.props;
const { Content } = await render(seite);
---

<Base title={seite.data.title} description={seite.data.description}>
  <div class="wrap prose">
    <h1>{seite.data.title}</h1>
    <Content />
  </div>
</Base>
