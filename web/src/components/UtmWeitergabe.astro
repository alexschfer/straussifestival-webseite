---
/**
 * Wird nur eingebunden, wenn ticket.utmWeitergeben in src/config.ts auf true steht.
 *
 * Hängt die UTM-Parameter (Werbeweg, z. B. utm_source=flyer) an alle Ticketlinks,
 * damit der Ticketshop sieht, woher ein Kauf kam (docs/TICKETSHOP-UTM.md).
 *
 * - Ohne Zustimmung im Cookie-Banner: nur die Parameter der aktuellen Adresse, also
 *   nur auf der Seite, auf der der Besucher gelandet ist. Nichts wird gespeichert.
 * - Mit Zustimmung: Die Parameter werden für die Dauer des Besuchs im sessionStorage
 *   gemerkt (gelöscht, sobald der Tab geschlossen wird), damit sie auch nach einem
 *   Wechsel auf eine Unterseite noch mitgehen. Widerruf löscht sie sofort.
 *   Speichern im Browser braucht nach § 25 TDDDG eine Einwilligung, deshalb nur so.
 */
---

<script>
  import { leseAntwort } from '../scripts/einwilligung';

  const UTM_PARAMETER = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const SPEICHER = 'straussi-werbeweg';

  /** UTM-Parameter der aktuellen Adresse (leer, wenn keine da sind). */
  const ausAdresse = new URLSearchParams();
  const aktuell = new URLSearchParams(location.search);
  for (const name of UTM_PARAMETER) {
    const wert = aktuell.get(name);
    if (wert) ausAdresse.set(name, wert);
  }

  const speichern = () => {
    try {
      if (ausAdresse.toString()) sessionStorage.setItem(SPEICHER, ausAdresse.toString());
    } catch {
      // Speicher gesperrt (z. B. privater Modus): dann eben nur von dieser Seite aus.
    }
  };

  const gemerkt = () => {
    try {
      return new URLSearchParams(sessionStorage.getItem(SPEICHER) ?? '');
    } catch {
      return new URLSearchParams();
    }
  };

  /** Werbeweg auf alle Ticketlinks schreiben. Was der Link selbst mitbringt, bleibt. */
  const anwenden = () => {
    const werbeweg = ausAdresse.toString() ? ausAdresse : leseAntwort() === 'ja' ? gemerkt() : new URLSearchParams();
    document.querySelectorAll<HTMLAnchorElement>('a[data-ticket-link]').forEach((link) => {
      const ziel = new URL(link.href);
      werbeweg.forEach((wert, name) => {
        if (!ziel.searchParams.has(name)) ziel.searchParams.set(name, wert);
      });
      link.href = ziel.href;
    });
  };

  if (leseAntwort() === 'ja') speichern();
  anwenden();

  // Antwort im Cookie-Banner auf dieser Seite: Zustimmung merkt den Werbeweg ab jetzt,
  // Ablehnen bzw. Widerruf löscht ihn.
  document.addEventListener('einwilligung', (ereignis) => {
    if ((ereignis as CustomEvent).detail === 'ja') {
      speichern();
    } else {
      try {
        sessionStorage.removeItem(SPEICHER);
      } catch {}
    }
  });
</script>
