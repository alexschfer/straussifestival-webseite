---
/**
 * Countdown to the start of the festival (festival.startTime in src/config.ts).
 * On first render it deliberately shows placeholder dashes instead of a number
 * computed at build time – otherwise, if the site is rarely rebuilt, a wrong number
 * could flash briefly before the script corrects it. After the start a text appears
 * instead of negative numbers.
 */
import { festival } from '../config';
import { TEXTS, languageOf } from '../i18n';

const t = TEXTS[languageOf(Astro.url)];
---

<div class="countdown" data-countdown data-target={festival.startTime}>
  <div class="countdown-fields" data-countdown-fields aria-label={t.countdownAria}>
    <div class="countdown-field">
      <span class="countdown-number" data-countdown-days>–</span>
      <span class="countdown-label">{t.days}</span>
    </div>
    <div class="countdown-field">
      <span class="countdown-number" data-countdown-hours>–</span>
      <span class="countdown-label">{t.hours}</span>
    </div>
    <div class="countdown-field">
      <span class="countdown-number" data-countdown-minutes>–</span>
      <span class="countdown-label">{t.minutes}</span>
    </div>
    <div class="countdown-field">
      <span class="countdown-number" data-countdown-seconds>–</span>
      <span class="countdown-label">{t.seconds}</span>
    </div>
  </div>
  <p class="countdown-over" data-countdown-over hidden>{t.countdownOver}</p>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-countdown]');

  if (container) {
    const target = new Date(container.dataset.target ?? '').getTime();
    const days = container.querySelector<HTMLElement>('[data-countdown-days]');
    const hours = container.querySelector<HTMLElement>('[data-countdown-hours]');
    const minutes = container.querySelector<HTMLElement>('[data-countdown-minutes]');
    const seconds = container.querySelector<HTMLElement>('[data-countdown-seconds]');
    const fields = container.querySelector<HTMLElement>('[data-countdown-fields]');
    const over = container.querySelector<HTMLElement>('[data-countdown-over]');

    let interval: ReturnType<typeof setInterval> | undefined;

    const twoDigits = (number: number) => String(number).padStart(2, '0');

    const update = () => {
      const remaining = target - Date.now();

      if (Number.isNaN(remaining) || remaining <= 0) {
        fields?.setAttribute('hidden', '');
        over?.removeAttribute('hidden');
        if (interval) clearInterval(interval);
        return;
      }

      const remainingSeconds = Math.floor(remaining / 1000);
      if (days) days.textContent = String(Math.floor(remainingSeconds / 86400));
      if (hours) hours.textContent = twoDigits(Math.floor((remainingSeconds % 86400) / 3600));
      if (minutes) minutes.textContent = twoDigits(Math.floor((remainingSeconds % 3600) / 60));
      if (seconds) seconds.textContent = twoDigits(remainingSeconds % 60);
    };

    update();
    interval = setInterval(update, 1000);
  }
</script>
