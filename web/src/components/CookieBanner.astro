---
/**
 * Cookie banner: one answer for statistics cookies (Matomo) and, if configured,
 * the Instagram feed (third-party widget). Only delivered when there is something
 * to consent to (bannerActive in src/config.ts). Without an answer nothing loads from
 * the third party, and Matomo counts without cookies.
 * "Decline" is deliberately just as large and easy to reach as "Accept".
 */
import { analyticsActive, instagram, ticket } from '../config';
import { TEXTS, localPath, languageOf } from '../i18n';

const feed = Boolean(instagram.widget.url);
const language = languageOf(Astro.url);
const t = TEXTS[language];
---

<div class="cookie-banner" role="dialog" aria-labelledby="cookie-title" aria-describedby="cookie-text" hidden data-cookie-banner>
  <div class="cookie-inner">
    <p id="cookie-title" class="cookie-title">{t.bannerTitle}</p>
    <p id="cookie-text" class="cookie-text">
      {
        analyticsActive && (
          <>
            {t.bannerStatistics}{' '}
          </>
        )
      }
      {
        ticket.forwardUtm && (
          <>
            {t.bannerChannel}{' '}
          </>
        )
      }
      {
        feed && (
          <>
            {t.bannerFeed(instagram.widget.provider)}{' '}
          </>
        )
      }
      {t.bannerMore[0]}<a href={`${localPath('/datenschutz/', language)}#cookies`}>{t.bannerMore[1]}</a>{t.bannerMore[2]}
    </p>
    {/* The data-answer values 'ja'/'nein' end up in visitors' browsers (localStorage)
        and must stay as they are, otherwise existing consents are lost. */}
    <div class="cookie-buttons">
      <button type="button" class="button button-small cookie-decline" data-answer="nein">{t.decline}</button>
      <button type="button" class="button button-small" data-answer="ja">{t.accept}</button>
    </div>
  </div>
</div>

<script>
  import { readAnswer, openBanner, saveAnswer } from '../scripts/consent';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  if (banner) {
    if (readAnswer() === null) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((button) => {
      button.addEventListener('click', () => {
        saveAnswer(button.dataset.answer === 'ja' ? 'ja' : 'nein');
        banner.hidden = true;
      });
    });

    document.addEventListener('consent-open', () => {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-answer]')?.focus();
    });

    // "Cookie settings" link in the footer
    document.querySelectorAll('[data-cookie-settings]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        openBanner();
      });
    });
  }
</script>
