---
/**
 * Cookie-Banner: eine Antwort für Statistik-Cookies (Matomo) und, falls eingetragen,
 * den Instagram-Feed (Widget eines Drittanbieters). Wird nur ausgeliefert, wenn es
 * etwas zuzustimmen gibt (bannerAktiv in src/config.ts). Ohne Antwort lädt nichts vom
 * Drittanbieter, und Matomo zählt ohne Cookies.
 * "Ablehnen" ist bewusst genauso groß und gut erreichbar wie "Akzeptieren".
 */
import { analyticsAktiv, instagram, ticket } from '../config';
import { TEXTE, lokal, spracheVon } from '../i18n';

const feed = Boolean(instagram.widget.url);
const sprache = spracheVon(Astro.url);
const t = TEXTE[sprache];
---

<div class="cookie-banner" role="dialog" aria-labelledby="cookie-titel" aria-describedby="cookie-text" hidden data-cookie-banner>
  <div class="cookie-inner">
    <p id="cookie-titel" class="cookie-titel">{t.bannerTitel}</p>
    <p id="cookie-text" class="cookie-text">
      {
        analyticsAktiv && (
          <>
            {t.bannerStatistik}{' '}
          </>
        )
      }
      {
        ticket.utmWeitergeben && (
          <>
            {t.bannerWerbeweg}{' '}
          </>
        )
      }
      {
        feed && (
          <>
            {t.bannerFeed(instagram.widget.anbieter)}{' '}
          </>
        )
      }
      {t.bannerMehr[0]}<a href={`${lokal('/datenschutz/', sprache)}#cookies`}>{t.bannerMehr[1]}</a>{t.bannerMehr[2]}
    </p>
    <div class="cookie-knoepfe">
      <button type="button" class="button button-klein cookie-ablehnen" data-antwort="nein">{t.ablehnen}</button>
      <button type="button" class="button button-klein" data-antwort="ja">{t.akzeptieren}</button>
    </div>
  </div>
</div>

<script>
  import { leseAntwort, oeffneBanner, speichereAntwort } from '../scripts/einwilligung';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  if (banner) {
    if (leseAntwort() === null) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-antwort]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        speichereAntwort(knopf.dataset.antwort === 'ja' ? 'ja' : 'nein');
        banner.hidden = true;
      });
    });

    document.addEventListener('einwilligung-oeffnen', () => {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-antwort]')?.focus();
    });

    // Link "Cookie-Einstellungen" in der Fußzeile
    document.querySelectorAll('[data-cookie-einstellungen]').forEach((link) => {
      link.addEventListener('click', (ereignis) => {
        ereignis.preventDefault();
        oeffneBanner();
      });
    });
  }
</script>
