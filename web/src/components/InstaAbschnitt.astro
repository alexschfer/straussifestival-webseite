---
/**
 * Abschnitt "Bleib auf dem Laufenden" mit Links zu Instagram und TikTok und Foto-Kacheln.
 * Gestaltung nach dem Vorbild von ricola.com/de-de ("Stay in the Loop"): vollflächiges
 * Farbfeld, reine Icon-Knöpfe, ein versetztes Kachelraster, das über den unteren Rand
 * des Farbfelds hinausragt. Alles kommt aus src/config.ts (Blöcke "instagram" und
 * "tiktok"). Die Fotos der Kacheln sind eigene Dateien aus public/insta/.
 *
 * Ist in der Config ein Instagram-Widget eingetragen (instagram.widget.url), ersetzt der
 * echte Feed die Kacheln, aber erst nach Zustimmung im Cookie-Banner. Vorher (und ohne
 * JavaScript) bleiben die Kacheln stehen, darunter ein Hinweis mit Knopf.
 *
 * Solange in instagram.fotos keine Fotos eingetragen sind, gibt es keine Kacheln
 * (keine "TODO Foto"-Platzhalter auf der Live-Seite). Dann bleibt nur das Farbfeld
 * mit Überschrift und den Knöpfen zu Instagram und TikTok.
 */
import { instagram, tiktok } from '../config';
import InstaIcon from './InstaIcon.astro';
import TikTokIcon from './TikTokIcon.astro';

const zeigeKacheln = instagram.fotos.length > 0;
const anzahl = Math.max(5, instagram.fotos.length);
const kacheln = Array.from({ length: anzahl }, (_, i) => instagram.fotos[i]);
const widget = instagram.widget;
---

<section class:list={['insta', { 'insta-ohne-kacheln': !zeigeKacheln }]} aria-labelledby="insta-titel">
  <div class="insta-panel">
    <h2 id="insta-titel">Bleib auf dem Laufenden</h2>
    <p class="insta-text">Folge uns auf Instagram oder TikTok, um nichts zu verpassen.</p>
    <div class="insta-links">
      <a
        class="insta-link"
        href={instagram.profilUrl}
        target="_blank"
        rel="noopener"
        aria-label={`${instagram.name} auf Instagram`}
      >
        <InstaIcon />
      </a>
      <a
        class="insta-link"
        href={tiktok.profilUrl}
        target="_blank"
        rel="noopener"
        aria-label={`${tiktok.name} auf TikTok`}
      >
        <TikTokIcon />
      </a>
    </div>
  </div>

  {/* Bewusst AUSSERHALB von .insta-panel: nur so kann das Farbfeld auf die
     Kopfzeile (Überschrift/Text/Icons) begrenzt bleiben, während die höheren
     Kacheln unten darüber hinausragen (siehe Kommentar in global.css). */}
  {
    zeigeKacheln && (
      <ul class="insta-kacheln" aria-label="Fotos" data-insta-kacheln>
        {kacheln.map((foto) => (
          <li class="insta-kachel">
            {foto ? (
              <img src={foto.bild} alt={foto.alt} loading="lazy" />
            ) : (
              <span class="insta-platzhalter">TODO Foto</span>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    widget.url && (
      <div class="insta-feed" data-insta-feed data-url={widget.url} data-hoehe={widget.hoehe}>
        <p class="insta-feed-hinweis" data-insta-feed-hinweis>
          Hier können unsere neuesten Instagram-Beiträge erscheinen. Dafür brauchen wir deine Zustimmung.
          <button type="button" class="button button-klein" data-insta-feed-zustimmen>
            Instagram-Feed anzeigen
          </button>
        </p>
      </div>
    )
  }
</section>

<script>
  import { leseAntwort, oeffneBanner } from '../scripts/einwilligung';

  // Echter Instagram-Feed: wird erst nach Zustimmung geladen und ersetzt dann die Kacheln.
  const feed = document.querySelector<HTMLElement>('[data-insta-feed]');

  if (feed) {
    const kachelRaster = document.querySelector<HTMLElement>('[data-insta-kacheln]');
    const hinweis = feed.querySelector<HTMLElement>('[data-insta-feed-hinweis]');

    const feedLaden = () => {
      if (feed.querySelector('iframe')) return;
      const rahmen = document.createElement('iframe');
      rahmen.src = feed.dataset.url ?? '';
      rahmen.title = 'Unsere neuesten Instagram-Beiträge';
      rahmen.loading = 'lazy';
      rahmen.style.height = `${feed.dataset.hoehe ?? 420}px`;
      feed.append(rahmen);
      if (hinweis) hinweis.hidden = true;
      if (kachelRaster) kachelRaster.hidden = true;
    };

    // Nach Widerruf (Antwort "nein") wird der Feed wieder entfernt.
    const feedEntfernen = () => {
      feed.querySelector('iframe')?.remove();
      if (hinweis) hinweis.hidden = false;
      if (kachelRaster) kachelRaster.hidden = false;
    };

    if (leseAntwort() === 'ja') feedLaden();
    document.addEventListener('einwilligung', (ereignis) => {
      if ((ereignis as CustomEvent).detail === 'ja') feedLaden();
      else feedEntfernen();
    });
    feed.querySelector('[data-insta-feed-zustimmen]')?.addEventListener('click', oeffneBanner);
  }

  // Leichte "Nachzieh"-Animation der Kacheln beim Scrollen (Vorbild ricola.com):
  // gerade und ungerade Kacheln verschieben sich unterschiedlich schnell. Die
  // eigentliche Bewegung steckt in der CSS-Variable --insta-fortschritt (0 bis 1,
  // je nachdem wie weit der Abschnitt durchs Bild gescrollt ist), ausgewertet in
  // global.css. Nur ohne reduzierte Bewegung aktiv.
  const raster = document.querySelector<HTMLElement>('[data-insta-kacheln]');

  if (raster && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    let angefragt = false;

    const aktualisieren = () => {
      angefragt = false;
      const rect = raster.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > innerHeight) return;
      const fortschritt = Math.min(1, Math.max(0, 1 - rect.top / innerHeight));
      raster.style.setProperty('--insta-fortschritt', String(fortschritt));
    };

    const anfragen = () => {
      if (!angefragt) {
        angefragt = true;
        requestAnimationFrame(aktualisieren);
      }
    };

    aktualisieren();
    addEventListener('scroll', anfragen, { passive: true });
  }
</script>
