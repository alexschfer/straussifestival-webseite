---
/**
 * Matomo tracking. Only included when the address and site ID are set
 * (analyticsActive in src/config.ts).
 *
 * - Without consent, Matomo counts without cookies ("requireCookieConsent").
 * - After "Accept" in the cookie banner it sets cookies and recognises visitors
 *   on later days as well; "Decline" or revoking consent deletes them again.
 * - Clicks on the ticket button are sent to Matomo as an event (category/action
 *   from config.ts, name = position of the button: header, hero, footer).
 * - Matomo additionally counts links to Instagram, TikTok and the ticket shop
 *   on its own as "Outlinks".
 * - Clicks on "Add to calendar" count as the event Kalender / Eintrag
 *   (name: google or ics).
 */
import { analytics, analyticsActive } from '../config';
import { STORAGE_KEY } from '../scripts/consent';

interface Props {
  /**
   * Default: Matomo counts the page view itself on load.
   * false: the page counts itself (only the redirect to Instagram, which may
   * only redirect after counting).
   */
  autoTrack?: boolean;
}

const { autoTrack = true } = Astro.props;
const settings = {
  url: analytics.url,
  siteId: analytics.siteId,
  autoTrack,
  storageKey: STORAGE_KEY,
  ticketCategory: analytics.ticketCategory,
  ticketAction: analytics.ticketAction,
  calendarCategory: analytics.calendarCategory,
  calendarAction: analytics.calendarAction,
};
---

{
  analyticsActive && (
    <script is:inline define:vars={{ settings }}>
      var _paq = (window._paq = window._paq || []);
      var consented = false;
      try {
        // 'ja' is the stored value for consent (kept as is for existing consents).
        consented = localStorage.getItem(settings.storageKey) === 'ja';
      } catch (error) {}

      // Without consent: count, but no cookies.
      _paq.push(['requireCookieConsent']);
      if (consented) _paq.push(['setCookieConsentGiven']);
      if (settings.autoTrack) {
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
      }
      _paq.push(['setTrackerUrl', settings.url + '/matomo.php']);
      _paq.push(['setSiteId', settings.siteId]);

      var script = document.createElement('script');
      script.async = true;
      script.src = settings.url + '/matomo.js';
      document.head.appendChild(script);

      // Important in all handlers below: always use window._paq, not the variable
      // _paq from above. As soon as matomo.js has loaded, Matomo replaces window._paq with
      // its own object; anything pushed into the old array after that is never read.

      // Answer in the cookie banner (see src/scripts/consent.ts)
      document.addEventListener('consent', function (event) {
        window._paq.push([event.detail === 'ja' ? 'setCookieConsentGiven' : 'forgetCookieConsentGiven']);
      });

      // Ticket button (TicketButton.astro, only while it is a real link)
      document.addEventListener('click', function (event) {
        var link = event.target.closest && event.target.closest('[data-ticket-link]');
        if (link) {
          window._paq.push(['trackEvent', settings.ticketCategory, settings.ticketAction, link.dataset.position]);
        }
        // "Add to calendar" button (CalendarButton.astro): name = google or ics
        var calendar = event.target.closest && event.target.closest('[data-calendar]');
        if (calendar) {
          window._paq.push(['trackEvent', settings.calendarCategory, settings.calendarAction, calendar.dataset.calendar]);
        }
      });
    </script>
  )
}
