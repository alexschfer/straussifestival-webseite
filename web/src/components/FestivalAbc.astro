---
/**
 * Festival ABC with a letter bar (FAQ page).
 *
 * The entries are still plain <dt>/<dd> pairs in faq.astro between
 * <FestivalAbc> and </FestivalAbc>. At build time the first term of each letter
 * automatically gets a jump target (id="abc-a", "abc-b" …), and the bar above
 * links every letter that has entries. Letters without an entry are shown
 * greyed out. Umlauts count towards their base letter (Ä -> A).
 * The bar stays at the top while scrolling through the ABC (global.css, .abc-bar).
 */

import { TEXTS, languageOf } from '../i18n';

const t = TEXTS[languageOf(Astro.url)];
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const UMLAUTS: Record<string, string> = { Ä: 'A', Ö: 'O', Ü: 'U' };

const html = await Astro.slots.render('default');
const present = new Set<string>();

const withAnchors = html.replace(/<dt(\s[^>]*)?>([\s\S]*?)<\/dt>/g, (whole, attributes = '', content: string) => {
  const firstLetter = content.replace(/<[^>]+>/g, '').trim().charAt(0).toUpperCase();
  const letter = UMLAUTS[firstLetter] ?? firstLetter;
  if (!ALPHABET.includes(letter) || present.has(letter)) return whole;
  present.add(letter);
  return `<dt id="abc-${letter.toLowerCase()}"${attributes}>${content}</dt>`;
});
---

<nav class="abc-bar" aria-label={t.abcAria}>
  <ul>
    {
      ALPHABET.map((letter) => (
        <li>
          {present.has(letter) ? (
            <a href={`#abc-${letter.toLowerCase()}`}>{letter}</a>
          ) : (
            <span aria-hidden="true">{letter}</span>
          )}
        </li>
      ))
    }
  </ul>
</nav>
<dl class="abc" set:html={withAnchors} />
