---
/**
 * A word in running text as a link to the ticket shop, e.g. <TicketLink>Tickets</TicketLink>.
 *
 * Counts like the ticket buttons: Matomo event "Ticket / Klick" with the name "text"
 * (Analytics.astro) and forwarding of the channel to the shop (UtmForwarding.astro),
 * both via the data-ticket-link attribute. Without a real ticket URL (ticketActive in
 * config.ts) it stays plain text.
 */
import { ticket, ticketActive } from '../config';
---

{
  ticketActive ? (
    <a href={ticket.url} target="_blank" rel="noopener" data-ticket-link data-position="text"><slot /></a>
  ) : (
    <slot />
  )
}
