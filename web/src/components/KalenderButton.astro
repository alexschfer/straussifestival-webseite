---
/**
 * Knopf "In den Kalender eintragen" (Startseite unter dem Countdown, Anfahrt).
 * Ein aufklappbares Menü ohne JavaScript (<details>) mit zwei Wegen:
 * - Google Kalender: Link, der in Google Kalender einen fertig ausgefüllten Termin öffnet.
 * - .ics-Datei (/kalender.ics, aus pages/kalender.ics.ts): öffnet auf iPhone/Mac den
 *   Apple-Kalender, sonst Outlook oder die Kalender-App des Handys.
 * Datum und Ort kommen aus src/config.ts (kalender, festival.adresse). Ganztägig,
 * solange es keine Uhrzeiten gibt. Es wird nichts von fremden Servern geladen.
 * Klicks zählt Matomo als Ereignis Kalender / Eintrag / google bzw. ics (Analytics.astro).
 */
import { festival, kalenderTage } from '../config';
import { TEXTE, spracheVon } from '../i18n';

const t = TEXTE[spracheVon(Astro.url)];

const tage = kalenderTage();
const seite = Astro.site ? new URL(Astro.site).origin : '';
const google = new URL('https://calendar.google.com/calendar/render');
google.searchParams.set('action', 'TEMPLATE');
google.searchParams.set('text', festival.name);
google.searchParams.set('dates', `${tage.beginn}/${tage.ende}`);
google.searchParams.set('location', festival.adresse);
google.searchParams.set('details', `${t.kalenderBeschreibung} ${seite}`);
---

<details class="kalender">
  <summary class="button">{t.kalenderKnopf}</summary>
  <ul class="kalender-auswahl">
    <li><a href={google.href} target="_blank" rel="noopener" data-kalender="google">{t.kalenderGoogle}</a></li>
    <li><a href="/kalender.ics" data-kalender="ics">{t.kalenderIcs}</a></li>
  </ul>
</details>
