---
import { ticket, ticketActive } from '../config';
import { TEXTS, languageOf } from '../i18n';

interface Props {
  /** Where the button sits; sent as the name in the Matomo event (see Analytics.astro). */
  position: 'header' | 'hero' | 'footer';
  /** Button text */
  text?: string;
  class?: string;
}

const t = TEXTS[languageOf(Astro.url)];
const { position, text = t.buyTickets, class: className } = Astro.props;

// As long as no real ticket URL is configured (ticketActive in config.ts), this shows
// a greyed-out button without a link and "soon", like the "soon" items in the menu.
// TODO: add the presale start date once it is fixed.
const textDisabled = t.soon;
---

{
  ticketActive ? (
    <a
      class:list={['button', className]}
      href={ticket.url}
      target="_blank"
      rel="noopener"
      data-ticket-link
      data-position={position}
    >
      {text}
    </a>
  ) : (
    <span class:list={['button', 'button-disabled', className]} aria-disabled="true">
      {t.tickets} <small>{textDisabled}</small>
    </span>
  )
}
