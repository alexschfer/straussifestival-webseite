---
import { ticket, ticketAktiv } from '../config';
import { TEXTE, spracheVon } from '../i18n';

interface Props {
  /** Wo der Button sitzt; geht im Matomo-Ereignis als Name mit (siehe Analytics.astro). */
  position: 'header' | 'hero' | 'footer';
  /** Buttontext */
  text?: string;
  class?: string;
}

const t = TEXTE[spracheVon(Astro.url)];
const { position, text = t.ticketsKaufen, class: klasse } = Astro.props;

// Solange keine echte Ticket-URL eingetragen ist (ticketAktiv in config.ts), steht hier
// ein ausgegrauter Button ohne Link mit "bald", wie die "bald"-Punkte im Menü.
// TODO: Datum des Vorverkaufsstarts ergänzen, sobald es feststeht.
const textAus = t.bald;
---

{
  ticketAktiv ? (
    <a
      class:list={['button', klasse]}
      href={ticket.url}
      target="_blank"
      rel="noopener"
      data-ticket-link
      data-position={position}
    >
      {text}
    </a>
  ) : (
    <span class:list={['button', 'button-aus', klasse]} aria-disabled="true">
      {t.tickets} <small>{textAus}</small>
    </span>
  )
}
