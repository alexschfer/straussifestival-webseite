---
import { ticket, ticketAktiv } from '../config';

interface Props {
  /** Wo der Button sitzt; geht im Matomo-Ereignis als Name mit (siehe Analytics.astro). */
  position: 'header' | 'hero' | 'footer';
  /** Buttontext */
  text?: string;
  class?: string;
}

const { position, text = 'Tickets kaufen', class: klasse } = Astro.props;

// Solange keine echte Ticket-URL eingetragen ist (ticketAktiv in config.ts), steht hier
// ein ausgegrauter Button ohne Link, wie die "bald"-Punkte im Menü. Klein (Kopfzeile)
// nur mit "bald", sonst mit dem Datum des Vorverkaufsstarts.
const textAus = klasse?.includes('button-klein') && position === 'header' ? 'bald' : `ab ${ticket.vorverkaufAb}`;
---

{
  ticketAktiv ? (
    <a
      class:list={['button', klasse]}
      href={ticket.url}
      target="_blank"
      rel="noopener"
      data-ticket-link
      data-position={position}
    >
      {text}
    </a>
  ) : (
    <span class:list={['button', 'button-aus', klasse]} aria-disabled="true">
      Tickets <small>{textAus}</small>
    </span>
  )
}
