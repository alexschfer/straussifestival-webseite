# Settings for the web server at Cloud86 (LiteSpeed/Apache, Plesk).
# Copied to dist/ by the build (web/integrations/channels-output.ts appends the channel redirects there) and uploaded with it.

# Always HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www.straussifestival.de -> straussifestival.de
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Own error page for unknown addresses (src/pages/404.astro)
ErrorDocument 404 /404.html

# Astro puts hashed files under /_astro/: they may be cached permanently.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
