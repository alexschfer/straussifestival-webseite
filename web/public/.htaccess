# Einstellungen für den Webserver bei Cloud86 (LiteSpeed/Apache, Plesk).
# Wird beim Build unverändert nach dist/ kopiert und mit hochgeladen.

# Immer HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www.straussifestival.de -> straussifestival.de
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Eigene Fehlerseite für unbekannte Adressen (src/pages/404.astro)
ErrorDocument 404 /404.html

# Astro legt gehashte Dateien unter /_astro/ ab: dürfen dauerhaft gecacht werden.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
