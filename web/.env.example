# Kopieren nach web/.env (wird nicht committet) und Werte eintragen.
# Alle Werte sind optional; fehlt etwas, funktioniert die Seite trotzdem.

# Öffentliche Adresse der Seite, ohne abschließenden Slash. Wird für die
# QR-Codes und die Links in docs/kanaele.md gebraucht. Vor dem Druck der
# QR-Codes zwingend setzen und neu bauen!
SITE_URL=https://festival.example.org

# Matomo-Tracking. Nur wenn BEIDE Werte gesetzt sind, wird Matomo eingebunden.
# Adresse der selbst gehosteten Matomo-Installation (stats.<domain>), ohne abschließenden Slash.
PUBLIC_MATOMO_URL=https://stats.example.org
# Website-ID aus Matomo (Administration > Websites > Verwalten, Spalte "ID"; die erste Website hat meist 1).
PUBLIC_MATOMO_SITE_ID=
