# Copy to web/.env (not committed) and fill in the values.
# All values are optional; if something is missing, the site still works.

# Public address of the site, without a trailing slash. Needed for the
# QR codes and the links in docs/channels.md. Must be set (and the site rebuilt)
# before printing the QR codes!
SITE_URL=https://festival.example.org

# Matomo tracking. Matomo is only included if BOTH values are set.
# Address of the self-hosted Matomo installation (stats.<domain>), without a trailing slash.
PUBLIC_MATOMO_URL=https://stats.example.org
# Site ID from Matomo (Administration > Websites > Manage, column "ID"; the first website usually has 1).
PUBLIC_MATOMO_SITE_ID=
