# Kopieren nach analytics/.env (wird nicht committet) und alle Werte ausfüllen:
#   cp .env.example .env
# Für einen Test auf dem eigenen Rechner: stattdessen .env.local.example kopieren.

# --- Domain -----------------------------------------------------------------
# Hauptdomain OHNE https:// und ohne Slash. Die Statistik läuft unter stats.<DOMAIN>.
# Beide Namen müssen per DNS auf die VM zeigen.
DOMAIN=festival.example.org

# E-Mail-Adresse für Hinweise von Let's Encrypt (z. B. Zertifikat läuft ab).
ACME_EMAIL=admin@example.org

# --- Geheimnisse ------------------------------------------------------------
# Jeden Wert einzeln erzeugen mit:  openssl rand -hex 32
# (nur Hex-Zeichen, dann gibt es keine Probleme mit Sonderzeichen in der Datenbank-URL)

# Passwort der Postgres-Datenbank. Nach dem ersten Start NICHT mehr ändern,
# die Datenbank hat es dann schon gespeichert.
POSTGRES_PASSWORD=

# Signiert die Anmeldungen in Umami. Pro Installation ein eigener Wert.
APP_SECRET=

# Verschlüsselt die Zwei-Faktor-Geheimnisse in Umami (genau 64 Hex-Zeichen).
TWO_FACTOR_ENCRYPTION_KEY=

# --- Optional -----------------------------------------------------------------
# Ordner mit der gebauten Webseite (Inhalt von web/dist/), relativ zu diesem Ordner.
# Auf dem Server liegt sie neben der docker-compose.yml in ./site (Standard).
# SITE_DIR=./site

# Ports von Caddy. Auf einem echten Server NICHT ändern (Let's Encrypt braucht 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443
