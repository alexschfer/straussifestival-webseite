# Copy to analytics/.env (not committed) and fill in all values:
#   cp .env.example .env
# For a test on your own computer: copy .env.local.example instead.

# --- Domain -----------------------------------------------------------------
# Main domain WITHOUT https:// and without a slash. Analytics runs at stats.<DOMAIN>.
# Both names must point to the VM via DNS.
DOMAIN=festival.example.org

# Email address for notices from Let's Encrypt (e.g. certificate about to expire).
ACME_EMAIL=admin@example.org

# --- Secrets ----------------------------------------------------------------
# Generate each value separately with:  openssl rand -hex 32
# (hex characters only, so there are no problems with special characters in the database URL)

# Password of the Postgres database. Do NOT change it after the first start,
# the database has already stored it by then.
POSTGRES_PASSWORD=

# Signs the logins in Umami. One separate value per installation.
APP_SECRET=

# Encrypts the two-factor secrets in Umami (exactly 64 hex characters).
TWO_FACTOR_ENCRYPTION_KEY=

# --- Optional -----------------------------------------------------------------
# Folder with the built website (contents of web/dist/), relative to this folder.
# On the server it sits next to docker-compose.yml in ./site (default).
# SITE_DIR=./site

# Caddy ports. Do NOT change them on a real server (Let's Encrypt needs 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443
