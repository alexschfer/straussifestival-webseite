# Caddy holt und erneuert HTTPS-Zertifikate automatisch (Let's Encrypt).
# Voraussetzung auf dem Server: DNS-Einträge für DOMAIN und stats.DOMAIN zeigen auf die VM,
# Ports 80 und 443 sind erreichbar.
# Werte kommen aus analytics/.env (über docker-compose.yml als Umgebungsvariablen).
{
	email {$ACME_EMAIL}
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

# Hauptdomain: statische Dateien der Astro-Seite
{$DOMAIN} {
	root * /srv/site
	encode zstd gzip

	# /q/flyer direkt als /q/flyer/index.html ausliefern (spart die Weiterleitung auf den Slash).
	try_files {path} {path}/index.html
	file_server

	# Astro legt gehashte Dateien unter /_astro/ ab: dauerhaft cachen.
	@gehasht path /_astro/*
	header @gehasht Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Umami (Statistik-Oberfläche und Tracking-Endpunkt)
stats.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
