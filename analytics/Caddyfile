# Caddy fetches and renews HTTPS certificates automatically (Let's Encrypt).
# Requirement on the server: DNS records for DOMAIN and stats.DOMAIN point to the VM,
# ports 80 and 443 are reachable.
# Values come from analytics/.env (as environment variables via docker-compose.yml).
{
	email {$ACME_EMAIL}
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

# Main domain: static files of the Astro site
{$DOMAIN} {
	root * /srv/site
	encode zstd gzip

	# Serve /q/flyer directly as /q/flyer/index.html (saves the redirect to the trailing slash).
	try_files {path} {path}/index.html
	file_server

	# Astro puts hashed files under /_astro/: cache them permanently.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# Umami (analytics UI and tracking endpoint)
stats.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
